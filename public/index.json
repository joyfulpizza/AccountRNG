<!DOCTYPE html>
<html>
<head>
<title>Roblox UserID Roller</title>
<style>
body {
    background: #111;
    color: white;
    font-family: Arial;
    text-align: center;
    margin-top: 100px;
}

button {
    padding: 15px 40px;
    font-size: 20px;
    cursor: pointer;
}

#result {
    margin-top: 40px;
    font-size: 28px;
}

#rarity {
    position: fixed;
    right: 30px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 22px;
}
</style>
</head>
<body>

<h1>🎲 Roblox UserID Roller</h1>

<button onclick="roll()">ROLL</button>

<div id="result"></div>
<div id="rarity"></div>

<script>
async function roll() {
    const res = await fetch("/roll");
    const data = await res.json();

    document.getElementById("result").innerText = "UserID: " + data.id;

    const rarityDiv = document.getElementById("rarity");
    rarityDiv.innerText = data.rarity;
    rarityDiv.style.color = data.color;
}
</script>

</body>
</html>
